<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup rules for Android 11 and below (android:fullBackupContent).
    Include only user-created state: the Room database and shared preferences.
    Because explicit include rules define the backup allowlist, cache, code_cache,
    no_backup, app files, and external files are not included.
-->
<full-backup-content>
    <include domain="database" path="." />
    <include domain="sharedpref" path="." />
</full-backup-content>
