<?xml version="1.0" encoding="utf-8"?>
<!-- Data extraction / device-transfer rules for Android 12+ (API 31+).
     Same policy as backup_rules.xml: user-created state (Room DB, prefs) may
     be backed up and transferred; caches and external files are excluded.
     Device-to-device transfer is allowed so a user can move their library
     index and playlists to a new phone; cloud backup follows the same rule. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <exclude domain="root" path="cache" />
        <exclude domain="root" path="code_cache" />
        <exclude domain="root" path="no_backup" />
        <exclude domain="file" path="." />
        <exclude domain="external_files" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <exclude domain="root" path="cache" />
        <exclude domain="root" path="code_cache" />
        <exclude domain="root" path="no_backup" />
        <exclude domain="file" path="." />
        <exclude domain="external_files" path="." />
    </device-transfer>
</data-extraction-rules>
