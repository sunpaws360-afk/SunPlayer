<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Legacy storage read is only needed up to Android 12L; newer releases
         use READ_MEDIA_AUDIO. Scoping with maxSdkVersion keeps the requested
         permission surface minimal. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- No INTERNET, no RECORD_AUDIO, no MANAGE_EXTERNAL_STORAGE:
         SunPlayer is offline-first by design. Do not add these casually. -->

    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="SunPlayer"
        android:icon="@android:drawable/ic_media_play"
        android:supportsRtl="true"
        android:theme="@style/Theme.SunPlayer">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- exported=true is required so Android Auto / Assistant / Bluetooth
             controllers can bind via MediaBrowserService. Media3 enforces
             session-level access control for controllers. -->
        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>
    </application>

</manifest>
